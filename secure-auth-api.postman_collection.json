{
	"info": {
		"_postman_id": "secure-auth-api-collection",
		"name": "Secure Auth API (SSL, 2FA, OTP, 30-Day Token & Profile Login)",
		"description": "Comprehensive Postman collection for Secure Auth API featuring SSL/TLS, auto-generated registration credentials, Forgot/Reset Password workflows, 30-day token issuance via OTP verification, and lightweight login response.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Register User (Auto-Generates Password & Sends Email)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Sayani Ghosh\",\n  \"email\": \"ghoshsayani008@gmail.com\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/api/v1/auth/register",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				}
			}
		},
		{
			"name": "2. Forgot Password (Dispatches Reset OTP to Email)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"ghoshsayani008@gmail.com\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/api/v1/auth/forgot-password",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
						"v1",
						"auth",
						"forgot-password"
					]
				}
			}
		},
		{
			"name": "3. Reset Password (Verify OTP & Set New Password)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"ghoshsayani008@gmail.com\",\n  \"otp\": \"PASTE_6_DIGIT_RESET_OTP_HERE\",\n  \"newPassword\": \"NewSecurePassword@2026\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/api/v1/auth/reset-password",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
						"v1",
						"auth",
						"reset-password"
					]
				}
			}
		},
		{
			"name": "4. Login (First Time from Device-A -> Triggers 2FA OTP)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"ghoshsayani008@gmail.com\",\n  \"password\": \"NewSecurePassword@2026\",\n  \"deviceId\": \"device-A\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/api/v1/auth/login",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				}
			}
		},
		{
			"name": "5. Verify 2FA OTP (Returns 30-Day JWT Token)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"ghoshsayani008@gmail.com\",\n  \"otp\": \"PASTE_2FA_OTP_FROM_CONSOLE_HERE\",\n  \"deviceId\": \"device-A\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/api/v1/auth/verify-otp",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
						"v1",
						"auth",
						"verify-otp"
					]
				}
			}
		},
		{
			"name": "6. Login from Trusted Device-A (Returns Profile Fields)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"ghoshsayani008@gmail.com\",\n  \"password\": \"NewSecurePassword@2026\",\n  \"deviceId\": \"device-A\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/api/v1/auth/login",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				}
			}
		},
		{
			"name": "7. Login Using 30-Day Token (Returns Profile Fields)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer PASTE_YOUR_30_DAY_JWT_HERE"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"deviceId\": \"device-A\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/api/v1/auth/login",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				}
			}
		},
		{
			"name": "8. Login from Different Device-B (Alerts & Sends OTP to User)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"ghoshsayani008@gmail.com\",\n  \"password\": \"NewSecurePassword@2026\",\n  \"deviceId\": \"device-B\"\n}"
				},
				"url": {
					"raw": "https://localhost:8443/api/v1/auth/login",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				}
			}
		},
		{
			"name": "9. Protected Endpoint - Hello (Requires Bearer Token)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer PASTE_YOUR_30_DAY_JWT_HERE"
					}
				],
				"url": {
					"raw": "https://localhost:8443/api/v1/demo/hello",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
						"v1",
						"demo",
						"hello"
					]
				}
			}
		},
		{
			"name": "10. Protected Endpoint - Profile (Requires Bearer Token)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer PASTE_YOUR_30_DAY_JWT_HERE"
					}
				],
				"url": {
					"raw": "https://localhost:8443/api/v1/demo/profile",
					"protocol": "https",
					"host": [
						"localhost"
					],
					"port": "8443",
					"path": [
						"api",
